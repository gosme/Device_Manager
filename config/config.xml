                </titlebar>
                <statusbar>
                    <background>#98f0b1</background>
                    <font_color>#55aaff</font_color>
                    <env_color>#000000</env_color>
                    <status_color>#000000</status_color>
                </statusbar>
                <widget>
                    <background>#ff557f</background>
                    <border>#000000</border>
                    <text>#000000</text>
                    <accent>#97ffa7</accent>
                </widget>
            </custom>
        </theme>
        <font>
            <name>Segoe UI Black</name>
            <title>
                <size>24</size>
                <weight>bold</weight>
            </title>
            <subtitle>
                <size>16</size>
                <weight>bold</weight>
            </subtitle>
            <text>
                <size>14</size>
                <weight>normal</weight>
            </text>
            <button>
                <size>12</size>
                <weight>bold</weight>
            </button>
        </font>
    </appearance>
    <logger>
        <enabled>true</enabled>
        <max_size_mb>5</max_size_mb>
        <max_duration_minutes>60</max_duration_minutes>
        <log_level>ERROR</log_level>
    </logger>
    <window>
        <resize_window>false</resize_window>
    </window>

</config>