                <widget>
                    <background>#333333</background>
                    <border>#aaaaaa</border>
                    <text>#ffffff</text>
                    <accent>#1e1e1e</accent>
                </widget>
            </dark>
            <focus>
                <tab>
                    <background>#ffffff</background>
                    <font_color>#000000</font_color>
                    <button_bg_color>#f0f0f0</button_bg_color>
                    <button_font_color>#000000</button_font_color>
                    <border_color>#cccccc</border_color>
                </tab>
                <toolbar>
                    <background>#1a252f</background>
                    <font_color>#ffffff</font_color>
                    <button_bg_color>#34495e</button_bg_color>
                    <button_hover_bg_color>#ffffff</button_hover_bg_color>
                    <button_tooltip_bg_color>#ffffff</button_tooltip_bg_color>
                </toolbar>
                <titlebar>
                    <background>#ffffff</background>
                    <font_color>#000000</font_color>
                    <separator_color>#000000</separator_color>
                    <tab_color>#000000</tab_color>
                </titlebar>
                <statusbar>
                    <background>#e0e0e0</background>
                    <font_color>#000000</font_color>
                    <env_color>#0000ff</env_color>
                    <status_color>#008000</status_color>
                </statusbar>
                <widget>
                    <background>#34495e</background>
                    <border>#bdc3c7</border>
                    <text>#bdc3c7</text>
                    <accent>#1a252f</accent>
                </widget>
            </focus>
            <custom>
                <tab>
                    <background>#97ffa7</background>
                    <font_color>#000000</font_color>
                    <button_bg_color>#ff557f</button_bg_color>
                    <button_font_color>#000000</button_font_color>
                    <border_color>#cccccc</border_color>
                </tab>
                <toolbar>
                    <background>#ffffff</background>
                    <font_color>#000000</font_color>
                    <button_bg_color>#f0f0f0</button_bg_color>
                    <button_hover_bg_color>#e0e0e0</button_hover_bg_color>
                    <button_tooltip_bg_color>#000000</button_tooltip_bg_color>
